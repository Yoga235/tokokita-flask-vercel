# Pengembangan lokal (PostgreSQL pgAdmin 4):
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tokokita_db
PGUSER=postgres
PGPASSWORD=GANTI_PASSWORD_LOKAL

# Opsional: isi untuk menguji Neon dari VS Code; kalau diisi, mengalahkan PG* di atas.
# Salin connection string persis dari tombol Connect Neon.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require

# Wajib untuk deploy Vercel (masukkan di dashboard Vercel, bukan GitHub):
# SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG
FLASK_DEBUG=1
